{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Privacy Aperture",
  "version": "0.1.0",
  "identifier": "com.privacyaperture.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Privacy Aperture",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local-first laptop privacy dimmer"
  }
}

